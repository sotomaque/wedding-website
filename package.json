{
  "name": "wedding-website",
  "version": "0.0.1",
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@workspace/typescript-config": "workspace:*",
    "knip": "^5.86.0",
    "lefthook": "^1.11.13",
    "next-openapi-gen": "^0.10.4",
    "prettier": "^3.7.4",
    "supabase": "^2.70.5",
    "turbo": "^2.7.4",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.5",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "biome:check": "biome check .",
    "biome:fix": "biome check --write .",
    "biome:format": "biome format --write .",
    "prepare": "lefthook install",
    "test": "bun --filter=web test __tests__",
    "test:e2e": "bun --filter=web test:e2e",
    "knip": "knip",
    "migrations:apply-scratch": "bun scripts/migrations-apply-scratch.ts"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
