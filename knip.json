{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    "apps/web": {
      "ignoreDependencies": [
        "@t3-oss/env-nextjs",
        "@tailwindcss/postcss",
        "postcss"
      ],
      "entry": [
        "app/**/*.{ts,tsx}",
        "lib/**/*.{ts,tsx}",
        "__tests__/**/*.{ts,tsx}",
        "e2e/**/*.{ts,tsx}"
      ],
      "project": [
        "app/**/*.{ts,tsx}",
        "lib/**/*.{ts,tsx}",
        "components/**/*.{ts,tsx}",
        "__tests__/**/*.{ts,tsx}",
        "e2e/**/*.{ts,tsx}"
      ],
      "playwright": {
        "config": ["playwright.config.ts"],
        "entry": ["e2e/**/*.{ts,spec.ts}"]
      }
    },
    "packages/ui": {
      "ignoreDependencies": ["postcss-load-config", "postcss"]
    },
    "packages/typescript-config": {
      "entry": ["*.json"],
      "ignoreDependencies": ["next"]
    }
  }
}
