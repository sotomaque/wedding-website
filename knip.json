{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignore": ["scripts/**"],
  "workspaces": {
    "apps/web": {
      "ignoreDependencies": [
        "@t3-oss/env-nextjs",
        "@tailwindcss/postcss",
        "postcss"
      ],
      "ignore": ["components/ai-elements/**"],
      "entry": [
        "app/**/*.{ts,tsx}",
        "lib/**/*.{ts,tsx}",
        "__tests__/**/*.{ts,tsx}",
        "e2e/**/*.{ts,tsx}"
      ],
      "project": [
        "app/**/*.{ts,tsx}",
        "lib/**/*.{ts,tsx}",
        "components/**/*.{ts,tsx}",
        "__tests__/**/*.{ts,tsx}",
        "e2e/**/*.{ts,tsx}"
      ],
      "playwright": {
        "config": ["playwright.config.ts"],
        "entry": ["e2e/**/*.{ts,spec.ts}"]
      }
    },
    "packages/ui": {
      "ignoreDependencies": [
        "postcss-load-config",
        "postcss",
        "@radix-ui/react-collapsible",
        "@radix-ui/react-dropdown-menu",
        "@radix-ui/react-select",
        "@radix-ui/react-separator",
        "@radix-ui/react-tooltip",
        "@streamdown/cjk",
        "@streamdown/code",
        "@streamdown/math",
        "@streamdown/mermaid",
        "ai",
        "motion",
        "nanoid",
        "shiki",
        "streamdown",
        "use-stick-to-bottom"
      ]
    },
    "packages/typescript-config": {
      "entry": ["*.json"],
      "ignoreDependencies": ["next"]
    }
  }
}
