generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Activity {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String
  description            String?
  link                   String?
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  emoji                  String?
  address                String?
  imageUrl               String?                 @map("image_url")
  latitude               Decimal?                @db.Decimal(10, 7)
  longitude              Decimal?                @db.Decimal(10, 7)
  isVenue                Boolean?                @default(false) @map("is_venue")
  venueType              VenueType?              @map("venue_type")
  displayOrder           Int?                    @default(0) @map("display_order")
  weddingId              String                 @map("wedding_id") @db.Uuid
  wedding                Wedding                @relation(fields: [weddingId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  guestActivityInterests GuestActivityInterest[]

  @@index([displayOrder], map: "idx_activities_display_order")
  @@index([isVenue], map: "idx_activities_is_venue")
  @@index([weddingId], map: "idx_activities_wedding_id")
  @@map("activities")
}

model Document {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  weddingId   String  @map("wedding_id") @db.Uuid
  title       String
  description String?
  fileUrl     String   @map("file_url")
  fileType    String   @map("file_type")
  fileSize    Int?     @map("file_size")
  category    DocumentCategory @default(other)
  uploadedBy  String           @map("uploaded_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  wedding     Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([category], map: "idx_documents_category")
  @@index([weddingId], map: "idx_documents_wedding_id")
  @@map("documents")
}

model Event {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  description      String?
  eventDate        DateTime?          @map("event_date") @db.Date
  startTime        DateTime?          @map("start_time") @db.Time(6)
  endTime          DateTime?          @map("end_time") @db.Time(6)
  locationName     String?            @map("location_name")
  locationAddress  String?            @map("location_address")
  latitude         Decimal?           @db.Decimal(10, 7)
  longitude        Decimal?           @db.Decimal(10, 7)
  isDefault        Boolean?           @default(false) @map("is_default")
  displayOrder     Int?               @default(0) @map("display_order")
  createdAt        DateTime?          @default(now()) @map("created_at") @db.Timestamptz(6)
  weddingId        String            @map("wedding_id") @db.Uuid
  wedding          Wedding           @relation(fields: [weddingId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  guestEventInvites GuestEventInvite[]

  @@index([displayOrder], map: "idx_events_display_order")
  @@index([eventDate], map: "idx_events_event_date")
  @@index([weddingId], map: "idx_events_wedding_id")
  @@map("events")
}

model Gift {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stripeCheckoutSessionId  String?   @unique @map("stripe_checkout_session_id")
  stripePaymentIntentId    String?   @map("stripe_payment_intent_id")
  stripePaymentLinkId      String?   @map("stripe_payment_link_id")
  stripeChargeId           String?   @unique @map("stripe_charge_id")
  donorEmail               String?   @map("donor_email")
  donorName                String?   @map("donor_name")
  amountCents              Int       @map("amount_cents")
  currency                 String    @default("usd")
  giftType                 GiftType? @map("gift_type")
  guestId                  String?   @map("guest_id") @db.Uuid
  status                   GiftStatus @default(completed)
  thankYouEmailSent        Boolean   @default(false) @map("thank_you_email_sent")
  thankYouEmailSentAt      DateTime? @map("thank_you_email_sent_at") @db.Timestamptz(6)
  createdAt                DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)
  notes                    String?
  weddingId                String   @map("wedding_id") @db.Uuid
  registryItemId           String?   @map("registry_item_id") @db.Uuid
  guest                    Guest?    @relation(fields: [guestId], references: [id], onUpdate: NoAction)
  wedding                  Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  registryItem             RegistryItem? @relation(fields: [registryItemId], references: [id], onUpdate: NoAction)

  @@index([createdAt(sort: Desc)], map: "idx_gifts_created_at")
  @@index([donorEmail], map: "idx_gifts_donor_email")
  @@index([giftType], map: "idx_gifts_gift_type")
  @@index([guestId], map: "idx_gifts_guest_id")
  @@index([status], map: "idx_gifts_status")
  @@index([stripeChargeId], map: "idx_gifts_stripe_charge")
  @@index([stripePaymentIntentId], map: "idx_gifts_stripe_payment_intent")
  @@index([stripeCheckoutSessionId], map: "idx_gifts_stripe_session")
  @@index([weddingId], map: "idx_gifts_wedding_id")
  @@index([registryItemId], map: "idx_gifts_registry_item_id")
  @@map("gifts")
}

model GuestActivityInterest {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  guestId     String   @map("guest_id") @db.Uuid
  activityId  String   @map("activity_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  inviteCode  String?  @map("invite_code")
  plannedDate DateTime? @map("planned_date") @db.Date
  status      ActivityInterestStatus? @default(interested)
  weddingId   String  @map("wedding_id") @db.Uuid
  activity    Activity @relation(fields: [activityId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  guest       Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  wedding     Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([activityId, status], map: "idx_guest_activity_interests_activity_status")
  @@index([inviteCode], map: "idx_guest_activity_interests_invite_code")
  @@index([weddingId], map: "idx_guest_activity_interests_wid")
  @@map("guest_activity_interests")
}

model GuestEventInvite {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  guestId          String    @map("guest_id") @db.Uuid
  eventId          String    @map("event_id") @db.Uuid
  rsvpStatus       RsvpStatus? @default(pending) @map("rsvp_status")
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  emailSent        Boolean?  @default(false) @map("email_sent")
  emailSentAt      DateTime? @map("email_sent_at") @db.Timestamptz(6)
  emailResendCount Int?      @default(0) @map("email_resend_count")
  weddingId        String   @map("wedding_id") @db.Uuid
  event            Event     @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  guest            Guest     @relation(fields: [guestId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  wedding          Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([guestId, eventId])
  @@index([eventId, emailSent], map: "idx_guest_event_invites_email_sent")
  @@index([eventId], map: "idx_guest_event_invites_event_id")
  @@index([guestId], map: "idx_guest_event_invites_guest_id")
  @@index([weddingId], map: "idx_guest_event_invites_wid")
  @@map("guest_event_invites")
}

model GuestHotelInterest {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  guestId        String?             @map("guest_id") @db.Uuid
  hotelId        String?             @map("hotel_id") @db.Uuid
  inviteCode     String              @map("invite_code")
  status         HotelInterestStatus
  checkInDate    DateTime?           @map("check_in_date") @db.Date
  checkOutDate   DateTime?           @map("check_out_date") @db.Date
  numberOfRooms  Int?                @map("number_of_rooms")
  notes          String?
  createdAt      DateTime?           @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime?           @default(now()) @map("updated_at") @db.Timestamp(6)
  weddingId      String             @map("wedding_id") @db.Uuid
  guest          Guest?              @relation(fields: [guestId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  hotel          Hotel?              @relation(fields: [hotelId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  wedding        Wedding            @relation(fields: [weddingId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([guestId, hotelId])
  @@index([guestId], map: "idx_guest_hotel_interests_guest_id")
  @@index([hotelId], map: "idx_guest_hotel_interests_hotel_id")
  @@index([inviteCode], map: "idx_guest_hotel_interests_invite_code")
  @@index([status], map: "idx_guest_hotel_interests_status")
  @@index([weddingId], map: "idx_guest_hotel_interests_wid")
  @@map("guest_hotel_interests")
}

model GuestPhoto {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  url          String
  uploaderName String?   @map("uploader_name")
  isVisible    Boolean   @default(true) @map("is_visible")
  uploadedAt   DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  hiddenAt     DateTime? @map("hidden_at") @db.Timestamptz(6)
  hiddenBy     String?   @map("hidden_by")
  weddingId    String   @map("wedding_id") @db.Uuid
  wedding      Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([weddingId], map: "idx_guest_photos_wedding_id")
  @@map("guest_photos")
}

model GuestTableAssignment {
  id             String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  seatingTableId String       @map("seating_table_id") @db.Uuid
  guestId        String       @unique @map("guest_id") @db.Uuid
  seatNumber     Int?         @map("seat_number")
  createdAt      DateTime?    @default(now()) @map("created_at") @db.Timestamptz(6)
  weddingId      String      @map("wedding_id") @db.Uuid
  guest          Guest        @relation(fields: [guestId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  seatingTable   SeatingTable @relation(fields: [seatingTableId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  wedding        Wedding     @relation(fields: [weddingId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([seatingTableId, guestId])
  @@index([guestId], map: "idx_guest_table_assignments_guest_id")
  @@index([seatingTableId], map: "idx_guest_table_assignments_table_id")
  @@index([weddingId], map: "idx_guest_table_assignments_wid")
  @@map("guest_table_assignments")
}

model Guest {
  id                                  String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                               String?
  inviteCode                          String?                 @map("invite_code")
  rsvpStatus                          RsvpStatus              @default(pending) @map("rsvp_status")
  plusOneAllowed                       Boolean                 @default(false) @map("plus_one_allowed")
  dietaryRestrictions                  String?                 @map("dietary_restrictions")
  numberOfResends                     Int                     @default(0) @map("number_of_resends")
  mailingAddress                      String?                 @map("mailing_address")
  physicalInviteSent                   Boolean                 @default(false) @map("physical_invite_sent")
  phoneNumber                         String?                 @map("phone_number")
  whatsapp                            String?
  preferredContactMethod              PreferredContactMethod? @map("preferred_contact_method")
  preferredLanguage                   String?                 @map("preferred_language")
  createdAt                           DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  side                                GuestSide?
  list                                GuestList               @default(a)
  isPlusOne                           Boolean                 @default(false) @map("is_plus_one")
  primaryGuestId                      String?                 @map("primary_guest_id") @db.Uuid
  firstName                           String                  @map("first_name")
  lastName                            String?                 @map("last_name")
  family                              Boolean                 @default(false)
  notes                               String?
  under21                             Boolean                 @default(false) @map("under_21")
  clerkUserId                         String?                 @map("clerk_user_id")
  activitiesEmailSent                 Boolean?                @default(false) @map("activities_email_sent")
  activitiesEmailSentAt               DateTime?               @map("activities_email_sent_at") @db.Timestamptz(6)
  activitiesEmailResendCount          Int?                    @default(0) @map("activities_email_resend_count")
  gender                              Gender?
  bridalPartyRole                     BridalPartyRole?        @map("bridal_party_role")
  partyId                             String?                 @map("party_id") @db.Uuid
  threeAndUnder                       Boolean                 @default(false) @map("three_and_under")
  hotelRecommendationEmailSent        Boolean?                @default(false) @map("hotel_recommendation_email_sent")
  hotelRecommendationEmailSentAt      DateTime?               @map("hotel_recommendation_email_sent_at") @db.Timestamp(6)
  hotelRecommendationEmailResendCount Int?                    @default(0) @map("hotel_recommendation_email_resend_count")
  arrivalDate                         DateTime?               @map("arrival_date") @db.Date
  arrivalTransport                    String?                 @map("arrival_transport")
  departureDate                       DateTime?               @map("departure_date") @db.Date
  departureTransport                  String?                 @map("departure_transport")
  accommodationNotes                  String?                 @map("accommodation_notes")
  weddingId                           String                 @map("wedding_id") @db.Uuid
  calendarInviteSent                  Boolean                 @default(false) @map("calendar_invite_sent")
  calendarInviteSentAt                DateTime?               @map("calendar_invite_sent_at") @db.Timestamptz(6)
  calendarInviteResendCount           Int                     @default(0) @map("calendar_invite_resend_count")
  lastReminderSentAt                  DateTime?               @map("last_reminder_sent_at") @db.Timestamptz(6)
  reminderCount                       Int                     @default(0) @map("reminder_count")
  gifts                               Gift[]
  guestActivityInterests              GuestActivityInterest[]
  guestEventInvites                   GuestEventInvite[]
  guestHotelInterests                 GuestHotelInterest[]
  guestTableAssignment                GuestTableAssignment?
  party                               Party?                  @relation(fields: [partyId], references: [id], onUpdate: NoAction)
  primaryGuest                        Guest?                  @relation("GuestPlusOne", fields: [primaryGuestId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  plusOnes                            Guest[]                 @relation("GuestPlusOne")
  wedding                             Wedding                @relation(fields: [weddingId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([bridalPartyRole], map: "idx_guests_bridal_party_role")
  @@index([clerkUserId], map: "idx_guests_clerk_user_id")
  @@index([gender], map: "idx_guests_gender")
  @@index([isPlusOne], map: "idx_guests_is_plus_one")
  @@index([list], map: "idx_guests_list")
  @@index([partyId], map: "idx_guests_party_id")
  @@index([primaryGuestId], map: "idx_guests_primary_guest")
  @@index([side], map: "idx_guests_side")
  @@index([threeAndUnder], map: "idx_guests_three_and_under")
  @@index([under21], map: "idx_guests_under_21")
  @@index([weddingId], map: "idx_guests_wedding_id")
  @@map("guests")
}

model Hotel {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String
  description         String?
  address             String?
  websiteUrl          String?              @map("website_url")
  phone               String?
  imageUrl            String?              @map("image_url")
  latitude            Decimal?             @db.Decimal(10, 7)
  longitude           Decimal?             @db.Decimal(10, 7)
  hotelType           HotelType?           @map("hotel_type")
  distanceToVenue     String?              @map("distance_to_venue")
  parkingInfo         String?              @map("parking_info")
  amenities           String?
  displayOrder        Int?                 @default(0) @map("display_order")
  createdAt           DateTime?            @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime?            @default(now()) @map("updated_at") @db.Timestamp(6)
  weddingId           String              @map("wedding_id") @db.Uuid
  guestHotelInterests GuestHotelInterest[]
  wedding             Wedding             @relation(fields: [weddingId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([displayOrder], map: "idx_hotels_display_order")
  @@index([hotelType], map: "idx_hotels_hotel_type")
  @@index([weddingId], map: "idx_hotels_wedding_id")
  @@map("hotels")
}

model Party {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inviteCode String     @unique @map("invite_code") @db.VarChar(10)
  name       String?    @db.VarChar(255)
  side       GuestSide?
  list       GuestList?
  family     String?    @db.VarChar(100)
  notes      String?
  createdAt  DateTime?  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime?  @default(now()) @map("updated_at") @db.Timestamptz(6)
  weddingId  String    @map("wedding_id") @db.Uuid
  guests     Guest[]
  wedding    Wedding   @relation(fields: [weddingId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([inviteCode], map: "idx_parties_invite_code")
  @@index([weddingId], map: "idx_parties_wedding_id")
  @@map("parties")
}

model Photo {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  url          String
  alt          String
  description  String?
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  weddingId    String  @map("wedding_id") @db.Uuid
  wedding      Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([weddingId], map: "idx_photos_wedding_id")
  @@map("photos")
}

model SeatingChart {
  id                    String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                  String
  defaultSeatsPerTable  Int            @default(8) @map("default_seats_per_table")
  isActive              Boolean        @default(false) @map("is_active")
  notes                 String?
  createdAt             DateTime?      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime?      @default(now()) @map("updated_at") @db.Timestamptz(6)
  weddingId             String        @map("wedding_id") @db.Uuid
  wedding               Wedding       @relation(fields: [weddingId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  seatingTables         SeatingTable[]

  @@index([isActive], map: "idx_seating_charts_is_active")
  @@index([weddingId], map: "idx_seating_charts_wedding_id")
  @@map("seating_charts")
}

model SeatingTable {
  id                    String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  seatingChartId        String                 @map("seating_chart_id") @db.Uuid
  tableNumber           Int                    @map("table_number")
  tableName             String?                @map("table_name")
  capacityOverride      Int?                   @map("capacity_override")
  positionX             Float?                 @default(0) @map("position_x")
  positionY             Float?                 @default(0) @map("position_y")
  shape                 SeatingShape?          @default(round)
  notes                 String?
  createdAt             DateTime?              @default(now()) @map("created_at") @db.Timestamptz(6)
  weddingId             String                @map("wedding_id") @db.Uuid
  guestTableAssignments GuestTableAssignment[]
  seatingChart          SeatingChart           @relation(fields: [seatingChartId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  wedding               Wedding               @relation(fields: [weddingId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([seatingChartId, tableNumber])
  @@index([seatingChartId], map: "idx_seating_tables_chart_id")
  @@index([weddingId], map: "idx_seating_tables_wedding_id")
  @@map("seating_tables")
}

model ServiceLink {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  weddingId   String  @map("wedding_id") @db.Uuid
  title       String
  url         String
  description String?
  category    ServiceLinkCategory @default(other)
  sortOrder   Int                 @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  wedding     Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([sortOrder], map: "idx_service_links_sort_order")
  @@index([weddingId], map: "idx_service_links_wedding_id")
  @@map("service_links")
}

model WeddingTodo {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  isCompleted  Boolean  @default(false) @map("is_completed")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  weddingId    String  @map("wedding_id") @db.Uuid
  wedding      Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([isCompleted, displayOrder], map: "idx_wedding_todos_order")
  @@index([weddingId], map: "idx_wedding_todos_wedding_id")
  @@map("wedding_todos")
}

model Wedding {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                  String                 @unique
  coupleName            String                 @map("couple_name")
  weddingDate           DateTime               @map("wedding_date") @db.Date
  rsvpDeadline          String?                @map("rsvp_deadline")
  timezone              String                 @default("America/New_York")
  status                WeddingStatus           @default(published)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @default(now()) @map("updated_at") @db.Timestamptz(6)

  // Contact & email
  contactEmail          String?                @map("contact_email")
  notificationEmails    String?                @map("notification_emails")
  emailFromName         String?                @map("email_from_name")
  emailFromAddress      String?                @map("email_from_address")

  // Couple details
  person1Name           String?                @map("person1_name")
  person2Name           String?                @map("person2_name")

  // Branding
  brandImageUrl         String?                @map("brand_image_url")
  brandImageAlt         String?                @map("brand_image_alt")

  // Theme
  themeId               String?                @map("theme_id")

  // i18n
  defaultLanguage       String                 @default("en") @map("default_language")

  // Feature toggles
  featureToggles        Json                   @default("{}") @map("feature_toggles") @db.JsonB

  // Relations
  activities            Activity[]
  chatMessages          ChatMessage[]
  documents             Document[]
  emailTemplates        EmailTemplate[]
  events                Event[]
  gifts                 Gift[]
  guestActivityInterests GuestActivityInterest[]
  guestEventInvites     GuestEventInvite[]
  guestHotelInterests   GuestHotelInterest[]
  guestPhotos           GuestPhoto[]
  guestTableAssignments GuestTableAssignment[]
  guests                Guest[]
  hotels                Hotel[]
  parties               Party[]
  photos                Photo[]
  registryItems         RegistryItem[]
  seatingCharts         SeatingChart[]
  seatingTables         SeatingTable[]
  serviceLinks          ServiceLink[]
  reminderSchedules     ReminderSchedule[]
  adminSummaryConfig    AdminSummaryConfig?
  weddingAdmins         WeddingAdmin[]
  weddingContent        WeddingContent[]
  weddingTodos          WeddingTodo[]

  @@index([slug], map: "idx_weddings_slug")
  @@map("weddings")
}

model EmailTemplate {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  weddingId String            @map("wedding_id") @db.Uuid
  type      EmailTemplateType
  language  String            @default("en")
  name      String
  subject   String
  htmlBody  String            @map("html_body") @db.Text
  isActive  Boolean           @default(true) @map("is_active")
  variables Json              @default("[]") @map("variables") @db.JsonB
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  wedding   Wedding           @relation(fields: [weddingId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([weddingId, type, language])
  @@index([weddingId], map: "idx_email_templates_wedding_id")
  @@map("email_templates")
}

model WeddingContent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  weddingId String   @map("wedding_id") @db.Uuid
  section   String
  content   Json     @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  wedding   Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@unique([weddingId, section])
  @@index([weddingId], map: "idx_wedding_content_wedding_id")
  @@map("wedding_content")
}

model RegistryItem {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  weddingId       String   @map("wedding_id") @db.Uuid
  title           String
  description     String?
  imageUrl        String?  @map("image_url")
  emoji           String?
  stripeUrl       String?  @map("stripe_url")
  stripeProductId String?  @map("stripe_product_id")
  displayOrder    Int      @default(0) @map("display_order")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  wedding         Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  gifts           Gift[]

  @@index([weddingId, displayOrder], map: "idx_registry_items_wedding_order")
  @@map("registry_items")
}

model ReminderSchedule {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  weddingId      String   @map("wedding_id") @db.Uuid
  daysBeforeDeadline Int  @map("days_before_deadline")
  isEnabled      Boolean  @default(true) @map("is_enabled")
  lastRunAt      DateTime? @map("last_run_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  wedding        Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([weddingId, daysBeforeDeadline])
  @@index([weddingId], map: "idx_reminder_schedules_wedding_id")
  @@map("reminder_schedules")
}

model AdminSummaryConfig {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  weddingId       String   @unique @map("wedding_id") @db.Uuid
  isEnabled       Boolean  @default(false) @map("is_enabled")
  frequencyDays   Int      @default(7) @map("frequency_days")
  lastRunAt       DateTime? @map("last_run_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  wedding         Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([weddingId], map: "idx_admin_summary_configs_wedding_id")
  @@map("admin_summary_configs")
}

model WeddingAdmin {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  weddingId   String   @map("wedding_id") @db.Uuid
  clerkUserId String?  @map("clerk_user_id")
  email       String
  role        String   @default("owner")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@unique([weddingId, email])
  @@index([weddingId], map: "idx_wedding_admins_wedding_id")
  @@index([clerkUserId], map: "idx_wedding_admins_clerk_user_id")
  @@index([email], map: "idx_wedding_admins_email")
  @@map("wedding_admins")
}

model ChatMessage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  weddingId String   @map("wedding_id") @db.Uuid
  adminEmail String  @map("admin_email")
  role      String   // "user" | "assistant"
  content   Json     @db.JsonB // stores the full UIMessage parts array
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  wedding   Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@index([weddingId, adminEmail, createdAt], map: "idx_chat_messages_wedding_admin")
  @@map("chat_messages")
}

