# Resend API Key
# Get your API key at: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Email addresses to receive RSVP notifications (comma-separated for multiple recipients)
RSVP_EMAIL=your-email@example.com,another-email@example.com
# Email shown in footer (single email for display)
NEXT_PUBLIC_RSVP_EMAIL=your-email@example.com

# Clerk Authentication
# Get your keys at: https://dashboard.clerk.com/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Admin email allowlist (comma-separated)
NEXT_PUBLIC_ADMIN_EMAILS=your-email@example.com,your-email@example.com
ADMIN_EMAILS=your-email@example.com,your-email@example.com

# Database Connection String (Supabase PostgreSQL via Kysely)
# Get from: https://supabase.com/dashboard/project/[your-project]/settings/database
# Under "Connection string" > "URI" - use the connection pooling string
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.xxxxxxxx:your-password@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# Application URL (used for generating RSVP links in emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# UploadThing (for photo uploads)
# Get your token at: https://uploadthing.com/dashboard
UPLOADTHING_TOKEN=your_uploadthing_token_here

# E2E Test ENVs
TEST_ADMIN_EMAIL=your_test_email@example.com
TEST_ADMIN_PASSWORD=your_test_password_here
# Shared secret for POST /api/e2e/reset (database reset + seed)
# Set the same value in GitHub Actions secrets and Vercel Preview env vars
E2E_RESET_SECRET=your_e2e_reset_secret_here

# Open AI API Key - for generating seating chart recommendations
OPENAI_API_KEY=your_openai_api_key_here

# Stripe Configuration
# Get your keys at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
# Webhook secret from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Stripe Payment Links (for gift registry)
# Create payment links at: https://dashboard.stripe.com/payment-links
# Use test links for local/staging, live links for production
NEXT_PUBLIC_STRIPE_LINK_BABY_FUND=https://buy.stripe.com/test_xxx
NEXT_PUBLIC_STRIPE_LINK_HONEYMOON=https://buy.stripe.com/test_xxx
NEXT_PUBLIC_STRIPE_LINK_STUDENT_LOANS=https://buy.stripe.com/test_xxx