# Resend API Key
# Get your API key at: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Email addresses to receive RSVP notifications (fallback if not set per-wedding)
RSVP_EMAIL=your-email@example.com,another-email@example.com

# Clerk Authentication
# Get your keys at: https://dashboard.clerk.com/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Admin email allowlist (comma-separated, server-side only)
ADMIN_EMAILS=your-email@example.com

# Database — Prisma reads connection strings from packages/db/.env
# Use `cd apps/web && bun run env:local` or `bun run env:prod` to switch environments
# See packages/db/.env.local-template for the local Supabase connection strings

# Application URL (used for generating RSVP links in emails and QR codes)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# UploadThing (for photo uploads)
# Get your token at: https://uploadthing.com/dashboard
UPLOADTHING_TOKEN=your_uploadthing_token_here

# E2E Test ENVs
TEST_ADMIN_EMAIL=your_test_email@example.com
TEST_ADMIN_PASSWORD=your_test_password_here
# Shared secret for POST /api/e2e/reset (database reset + seed)
E2E_RESET_SECRET=your_e2e_reset_secret_here

# Open AI API Key - for generating seating chart recommendations
OPENAI_API_KEY=your_openai_api_key_here

# Stripe Configuration
# Get your keys at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
# Webhook secret from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Stripe Product IDs (used for matching gift types from webhooks)
STRIPE_PRODUCT_BABY_FUND=prod_xxx
STRIPE_PRODUCT_HONEYMOON=prod_xxx
STRIPE_PRODUCT_STUDENT_LOANS=prod_xxx

# Geoapify (address autocomplete)
# Get your key at: https://myprojects.geoapify.com/
NEXT_PUBLIC_GEOAPIFY_API_KEY=your_geoapify_api_key_here

# Vercel Cron Secret
CRON_SECRET='h#yXc!mQ5xdenPjj'